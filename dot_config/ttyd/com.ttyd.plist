<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ttyd</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/georges.plancke/.config/ttyd/ttyd-launch.sh</string>
    </array>

    <!-- Run at boot, but as the user (not root) so it uses your fonts/theme -->
    <key>UserName</key>
    <string>georges.plancke</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- tinty rewrites theme.json on `tinty apply`; launchd restarts ttyd to apply it -->
    <key>WatchPaths</key>
    <array>
        <string>/Users/georges.plancke/.config/ttyd/theme.json</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/georges.plancke</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/georges.plancke/.config/ttyd/ttyd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/georges.plancke/.config/ttyd/ttyd.log</string>
</dict>
</plist>
